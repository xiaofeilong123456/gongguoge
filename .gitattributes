# 统一换行符策略
#
# 背景：Windows 默认 core.autocrlf=true 会把文本文件在**检出时**转成 CRLF。
# 而 deploy/ 下的 Shell 脚本一旦带 CRLF，在 Linux 上会直接报：
#   bash: ./setup-server.sh: /bin/bash^M: bad interpreter
#   \r: command not found
# 所以这些文件必须锁定为 LF。

* text=auto

# ---- 必须在 Linux 上运行的文件：强制 LF ----
*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf

# ---- 后端与脚本：统一 LF，避免跨平台 diff 噪音 ----
*.java    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.properties text eol=lf

# ---- 前端 ----
*.js      text eol=lf
*.mjs     text eol=lf
*.vue     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf

# ---- 文档与配置 ----
*.md      text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# ---- 二进制文件不做换行转换 ----
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.jar     binary
*.ttf     binary
*.woff    binary
*.woff2   binary
