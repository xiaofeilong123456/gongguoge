[Unit]
Description=Gongguoge Backend (功过格后端)
After=network.target mysqld.service redis.service
Wants=mysqld.service redis.service

[Service]
Type=simple
# 用专用低权限用户运行，不要用 root
User=gongguoge
Group=gongguoge
WorkingDirectory=/opt/gongguoge

# ============================================================
# 所有环境变量（数据库密码 / JWT 密钥 / 阿里云短信密钥）都从这个文件读取。
#
# 为什么这样设计：
#   本文件会被提交到 Git 仓库，而 /opt/gongguoge/app.env 只存在于服务器上，
#   两者分开后，真实密钥永远不会进仓库。
#
# 首次部署前需在服务器创建该文件（见 DEPLOY.md 第 4.4 节），
# 内容模板见仓库里的 deploy/app.env.example
# ============================================================
EnvironmentFile=/opt/gongguoge/app.env

# 2 核 2G 的机器：堆内存留 512M 给后端，其余给 MySQL 与 Redis
ExecStart=/usr/bin/java -Xms256m -Xmx512m -Dfile.encoding=UTF-8 \
  -jar /opt/gongguoge/gongguoge-backend-1.0.0.jar \
  --spring.profiles.active=prod

Restart=always
RestartSec=5
SuccessExitStatus=143

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
