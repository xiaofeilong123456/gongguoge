# ============================================================
# 功过格后端 · 服务器环境变量模板
#
# 用法：在服务器上创建 /opt/gongguoge/app.env，内容照抄本文件并填好真实值。
#      该文件【只存在于服务器】，不要提交到仓库（本 .example 才是提交的那份）。
#
# 创建命令见 DEPLOY.md 第 4.4 节。
# 改完变量后需重启：systemctl restart gongguoge
#
# 注意：systemd 的 EnvironmentFile 不支持行内注释，
#      值不要加引号、不要有行尾注释，一行一个 KEY=VALUE。
# ============================================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gongguoge
MYSQL_USER=gongguoge
# 填 3.2 节里给 gongguoge 用户设的密码
MYSQL_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 必须填随机长串（≥32 字节），生成：openssl rand -base64 48
# 留空后端会拒绝启动，这是故意的防呆
JWT_SECRET=
JWT_EXPIRATION=604800

# ---------- 阿里云短信验证码 ----------
# 正式上线必须为 true，否则用户收不到验证码、无法登录
ALIYUN_SMS_ENABLED=true
# 上线后这项留空（它只是开发用的固定验证码）
ALIYUN_SMS_MOCK_CODE=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信签名名称（控制台已审核通过的那个）
ALIYUN_SMS_SIGN_NAME=
# 短信模板编号
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com

# ---------- 上传文件 ----------
# 用绝对路径，避免因启动工作目录不同而找不到已上传的头像
UPLOAD_DIR=/opt/gongguoge/uploads
UPLOAD_MAX_SIZE=2MB
