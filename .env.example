# ===== Docker Compose / 本地开发默认值 =====
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进仓库。

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gongguoge
MYSQL_USER=gongguoge
MYSQL_PASSWORD=gongguoge123
MYSQL_ROOT_PASSWORD=root123456

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO（预留的对象存储，后端暂未接入）---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=gongguoge

# --- JWT（必须设置；至少 32 字节随机串）---
# 生成方式：openssl rand -base64 48
# 注意：后端 application.yml 故意不给默认值，缺失会导致启动失败，
#       这是为了避免用公开的弱密钥上线、被伪造任意用户 token。
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=604800

# --- 阿里云短信（号码认证服务 Dypnsapi）---
# 留空且 ALIYUN_SMS_ENABLED=false 时，验证码使用下面的 mock 值，不会真实发送。
# 需要真实发短信时：开通「号码认证服务 Dypnsapi」→ 申请短信签名与模板 → 创建 AccessKey。
# 注意：ALIYUN_SMS_ENABLED=false 且 ALIYUN_SMS_MOCK_CODE 留空时，后端会拒绝启动。
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_MOCK_CODE=123456
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信签名名称（控制台申请并审核通过的那个，例如「XX验证码」）
ALIYUN_SMS_SIGN_NAME=
# 短信模板编号（控制台申请，模板需含 ${code} 与 ${min} 两个变量）
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
