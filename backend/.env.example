# ===== 功过格后端环境变量 =====
# 复制为 backend/.env 并按本机情况填写。
# 注意：application.yml 读取的是「环境变量」，不是这个文件本身，
# 请用 IDE 运行配置、Docker、或 shell 的 set/export 注入这些变量。

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gongguoge
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Redis（登录态与短信验证码依赖，必须启动）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT（必须设置，且必须是随机长字符串，至少 32 字节）---
# 生成方式：openssl rand -base64 48
# 注意：application.yml 故意不给默认值，这里留空会导致后端启动失败，
#       这是为了避免用公开的弱密钥上线。
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=604800

# --- 阿里云短信（号码认证服务 Dypnsapi）---
# false = 使用 mock 验证码，不真实发送（推荐本地开发）
ALIYUN_SMS_ENABLED=false
# 短信未启用时的固定验证码，仅供开发。
# 注意：SMS_ENABLED=false 且此项留空时，后端会拒绝启动（避免固定验证码被带到公网）。
ALIYUN_SMS_MOCK_CODE=123456
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信签名名称（控制台申请并审核通过的那个，例如「XX验证码」）
ALIYUN_SMS_SIGN_NAME=
# 短信模板编号（模板需含 ${code} 与 ${min} 两个变量）
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
